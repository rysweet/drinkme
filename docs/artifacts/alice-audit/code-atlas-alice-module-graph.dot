digraph alice_code_atlas {
  rankdir=LR;
  node [shape=box];

  root [label="root pom.xml\norg.alice:parent"];
  core [label="core aggregator"];
  external [label="external aggregator"];
  alice_ide [label="alice-ide\norg.alice:alice-ide"];
  netbeans [label="netbeans\norg.alice:netbeans"];
  installer [label="installer\nprofile: buildInstaller"];
  nonfree [label="core-nonfree\nprofile: includeSims"];

  root -> core;
  root -> external;
  root -> alice_ide;
  root -> netbeans;
  root -> installer [style=dashed, label="buildInstaller"];
  root -> nonfree [style=dashed, label="includeSims"];

  core -> util;
  core -> tweedle;
  core -> ast;
  core -> scenegraph;
  core -> glrender;
  core -> story_api;
  core -> models;
  core -> story_api_migration;
  core -> model_loading;
  core -> croquet;
  core -> ide;
  core -> resources;
  core -> i18n;
  core -> image_editor;
  core -> issue_reporting;
  external -> collada;
  external -> collada_schema;
  external -> wrapped_flow_layout;

  ast -> tweedle;
  ast -> util;
  scenegraph -> util;
  glrender -> scenegraph;
  story_api -> ast;
  story_api -> scenegraph;
  story_api -> glrender;
  story_api -> tweedle;
  story_api -> util;
  story_api -> collada_schema;
  models -> story_api;
  models -> util;
  story_api_migration -> ast;
  story_api_migration -> story_api;
  story_api_migration -> model_loading;
  story_api_migration -> models;
  story_api_migration -> tweedle;
  model_loading -> story_api;
  model_loading -> scenegraph;
  model_loading -> glrender;
  model_loading -> ast;
  model_loading -> util;
  model_loading -> collada;
  model_loading -> collada_schema;
  croquet -> util;
  croquet -> wrapped_flow_layout;
  image_editor -> croquet;
  issue_reporting -> util;
  ide -> story_api;
  ide -> story_api_migration;
  ide -> models;
  ide -> scenegraph;
  ide -> glrender;
  ide -> ast;
  ide -> croquet;
  ide -> resources;
  ide -> i18n;
  ide -> image_editor;
  ide -> issue_reporting;
  ide -> util;
  alice_ide -> ide;
  netbeans -> story_api;
  netbeans -> story_api_migration;
  netbeans -> models;
  netbeans -> scenegraph;
  netbeans -> glrender;
  netbeans -> ast;
  netbeans -> tweedle;
  netbeans -> util;
  installer -> alice_ide;

  models_nonfree -> story_api;
  models_nonfree -> util;
  story_api_nonfree -> story_api;
  story_api_nonfree -> models_nonfree;
  ide_nonfree -> ide;
  ide_nonfree -> story_api_nonfree;
  ide_nonfree -> resources_nonfree;
}
